/* ============================================
 * 微信小程序全局样式表 app.wxss
 * 设计规范：颜色 / 字体 / 间距 / 圆角 / 阴影 / 组件
 * 单位说明：rpx（750rpx = 屏宽）/ px（固定尺寸）
 * ============================================ */

/* ------------------ 一、设计令牌（CSS 变量） ------------------ */
page {
  /* —— 主色板 —— */
  --color-primary: #07C160;
  --color-primary-dark: #06AD56;
  --color-primary-light: #5FD89A;

  /* —— 功能色 —— */
  --color-success: #07C160;
  --color-warning: #FA9D3B;
  --color-danger: #FA5150;
  --color-info: #10AEFF;

  /* —— 文字色 —— */
  --text-primary: #1A1A1A;
  --text-regular: #333333;
  --text-secondary: #666666;
  --text-placeholder: #999999;
  --text-disabled: #CCCCCC;
  --text-inverse: #FFFFFF;

  /* —— 背景色 —— */
  --bg-page: #F7F7F7;
  --bg-card: #FFFFFF;
  --bg-mask: rgba(0, 0, 0, 0.5);
  --bg-hover: #F5F5F5;

  /* —— 边框色 —— */
  --border-base: #EAEAEA;
  --border-light: #F0F0F0;
  --border-dark: #DDDDDD;

  /* —— 字号 —— */
  --font-size-xs: 22rpx;   /* 11px 小字 */
  --font-size-sm: 24rpx;   /* 12px 辅助文本 */
  --font-size-base: 28rpx; /* 14px 正文 */
  --font-size-md: 30rpx;   /* 15px 输入框 */
  --font-size-lg: 32rpx;   /* 16px 副标题 */
  --font-size-xl: 36rpx;   /* 18px 标题 */
  --font-size-2xl: 44rpx;  /* 22px 大标题 */

  /* —— 字重 —— */
  --fw-regular: 400;
  --fw-medium: 500;
  --fw-semibold: 600;
  --fw-bold: 700;

  /* —— 行高 —— */
  --line-height-tight: 1.2;
  --line-height-base: 1.5;
  --line-height-loose: 1.75;

  /* —— 间距（8 的倍数） —— */
  --spacing-xs: 8rpx;   /* 4px */
  --spacing-sm: 16rpx;  /* 8px */
  --spacing-md: 24rpx;  /* 12px */
  --spacing-lg: 32rpx;  /* 16px */
  --spacing-xl: 48rpx;  /* 24px */
  --spacing-2xl: 64rpx; /* 32px */

  /* —— 圆角 —— */
  --radius-sm: 4rpx;
  --radius-md: 8rpx;
  --radius-lg: 16rpx;
  --radius-xl: 24rpx;
  --radius-pill: 999rpx;

  /* —— 阴影 —— */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);

  /* —— 动效 —— */
  --duration-fast: 150ms;
  --duration-base: 250ms;
  --duration-slow: 400ms;
  --ease-out: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);

  /* —— 字体族 —— */
  --font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", "Helvetica Neue",
    Helvetica, Arial, sans-serif;

  /* —— 页面默认背景 —— */
  background-color: var(--bg-page);
  color: var(--text-regular);
  font-family: var(--font-family);
  font-size: var(--font-size-base);
  line-height: var(--line-height-base);
}

/* ------------------ 二、基础重置 ------------------ */
view, text, image, navigator, scroll-view,
swiper, button, input, textarea, form {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

image {
  display: block;
  width: 100%;
  height: auto;
}

/* ------------------ 三、文字工具类 ------------------ */
.text-xs { font-size: var(--font-size-xs); }
.text-sm { font-size: var(--font-size-sm); }
.text-base { font-size: var(--font-size-base); }
.text-md { font-size: var(--font-size-md); }
.text-lg { font-size: var(--font-size-lg); }
.text-xl { font-size: var(--font-size-xl); }
.text-2xl { font-size: var(--font-size-2xl); }

.text-regular { font-weight: var(--fw-regular); }
.text-medium { font-weight: var(--fw-medium); }
.text-semibold { font-weight: var(--fw-semibold); }
.text-bold { font-weight: var(--fw-bold); }

.text-primary { color: var(--text-primary); }
.text-secondary { color: var(--text-secondary); }
.text-placeholder { color: var(--text-placeholder); }
.text-disabled { color: var(--text-disabled); }
.text-inverse { color: var(--text-inverse); }
.text-brand { color: var(--color-primary); }
.text-danger { color: var(--color-danger); }
.text-warning { color: var(--color-warning); }
.text-info { color: var(--color-info); }

.text-center { text-align: center; }
.text-left { text-align: left; }
.text-right { text-align: right; }
.text-ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.text-line-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ------------------ 四、间距与布局工具类 ------------------ */
/* 内边距 */
.p-xs { padding: var(--spacing-xs); }
.p-sm { padding: var(--spacing-sm); }
.p-md { padding: var(--spacing-md); }
.p-lg { padding: var(--spacing-lg); }
.p-xl { padding: var(--spacing-xl); }

/* 外边距 */
.m-xs { margin: var(--spacing-xs); }
.m-sm { margin: var(--spacing-sm); }
.m-md { margin: var(--spacing-md); }
.m-lg { margin: var(--spacing-lg); }
.m-xl { margin: var(--spacing-xl); }

/* 水平内边距（页面安全边距） */
.px-page { padding-left: var(--spacing-lg); padding-right: var(--spacing-lg); }

/* Flex 布局 */
.flex { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.flex-row { display: flex; flex-direction: row; }
.flex-wrap { flex-wrap: wrap; }
.flex-1 { flex: 1; }
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}
.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.flex-start { align-items: flex-start; }
.flex-end { align-items: flex-end; }
.items-center { align-items: center; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }

/* ------------------ 五、圆角工具类 ------------------ */
.radius-sm { border-radius: var(--radius-sm); }
.radius-md { border-radius: var(--radius-md); }
.radius-lg { border-radius: var(--radius-lg); }
.radius-xl { border-radius: var(--radius-xl); }
.radius-pill { border-radius: var(--radius-pill); }

/* ------------------ 六、组件样式 ------------------ */

/* —— 按钮 —— */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-lg);
  border-radius: var(--radius-pill);
  transition: opacity var(--duration-fast) var(--ease-out);
}
.btn::after { border: none; }
.btn-primary {
  height: 88rpx;
  padding: 0 var(--spacing-lg);
  background-color: var(--color-primary);
  color: var(--text-inverse);
}
.btn-secondary {
  height: 72rpx;
  padding: 0 var(--spacing-md);
  font-size: var(--font-size-base);
  background-color: var(--bg-card);
  color: var(--text-regular);
  border: 1rpx solid var(--border-base);
  border-radius: var(--radius-md);
}
.btn-text {
  height: 56rpx;
  padding: 0 var(--spacing-sm);
  font-size: var(--font-size-base);
  background-color: transparent;
  color: var(--color-primary);
}
.btn-danger {
  background-color: var(--color-danger);
  color: var(--text-inverse);
}
.btn[disabled] {
  opacity: 0.5;
}

/* —— 卡片 —— */
.card {
  background-color: var(--bg-card);
  padding: var(--spacing-lg);
  border-radius: var(--radius-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-sm);
}
.card-title {
  font-size: var(--font-size-lg);
  font-weight: var(--fw-semibold);
  color: var(--text-primary);
  margin-bottom: var(--spacing-md);
}

/* —— 输入框 —— */
.input {
  height: 88rpx;
  padding: 0 var(--spacing-md);
  font-size: var(--font-size-md);
  background-color: var(--bg-page);
  border-radius: var(--radius-md);
  color: var(--text-primary);
}
.input-placeholder {
  color: var(--text-placeholder);
}

/* —— 列表 —— */
.list-item {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: var(--spacing-md) var(--spacing-lg);
  background-color: var(--bg-card);
  border-bottom: 1rpx solid var(--border-light);
}
.list-item:last-child { border-bottom: none; }
.list-item-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: var(--spacing-md);
}
.list-item-title {
  flex: 1;
  font-size: var(--font-size-base);
  color: var(--text-primary);
}

/* —— 头像 —— */
.avatar {
  border-radius: 50%;
  background-color: var(--border-light);
}
.avatar-sm { width: 64rpx; height: 64rpx; }
.avatar-md { width: 88rpx; height: 88rpx; }
.avatar-lg { width: 128rpx; height: 128rpx; }

/* —— 分割线 —— */
.divider {
  height: 1rpx;
  background-color: var(--border-light);
  margin: var(--spacing-md) 0;
}

/* —— 标签 Tag —— */
.tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 var(--spacing-sm);
  font-size: var(--font-size-xs);
  border-radius: var(--radius-sm);
  background-color: var(--bg-hover);
  color: var(--text-secondary);
}
.tag-primary {
  background-color: rgba(7, 193, 96, 0.1);
  color: var(--color-primary);
}
.tag-danger {
  background-color: rgba(250, 81, 80, 0.1);
  color: var(--color-danger);
}

/* —— 空状态 —— */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-2xl) 0;
}
.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: var(--spacing-md);
}
.empty-text {
  font-size: var(--font-size-sm);
  color: var(--text-placeholder);
}

/* ------------------ 七、安全区适配 ------------------ */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
.safe-top {
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top);
}

/* ------------------ 八、通用辅助类 ------------------ */
.full-width { width: 100%; }
.full-height { height: 100%; }
.relative { position: relative; }
.absolute { position: absolute; }
.fixed { position: fixed; }
.hidden { display: none; }
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.bg-page { background-color: var(--bg-page); }
.bg-card { background-color: var(--bg-card); }
